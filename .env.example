# Variables de entorno para docker-compose.yml (Kompralo / auth-backend)
# Copia este archivo a .env y rellena los valores reales. NUNCA subas .env.

# Base de datos
POSTGRES_DB=kompralo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto

# Spring datasource (usado por el servicio app)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/kompralo
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=cambia_esto

# JWT
JWT_SECRET=cambia_esto_por_una_clave_de_al_menos_256_bits
JWT_EXPIRATION=86400000

# Gmail API (OAuth2)
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_FROM_ADDRESS=kompralomarketplace@gmail.com
GMAIL_API_FROM_NAME=Soporte Kompralo App
